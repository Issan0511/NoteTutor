# Optional Claude features: 1 = show and enable, 0 = disabled (default).
NOTETUTOR_CLAUDE_ENABLED=0

# Claude API key. Fill in .env, never commit the actual key.
ANTHROPIC_API_KEY=

# Optional: leave blank to use the application's default Claude model.
NOTETUTOR_CLAUDE_MODEL=claude-sonnet-5-5
# Optional: use a different model for background transcription.
NOTETUTOR_VISION_MODEL=claude-sonnet-5-5

# Start background transcription on launch (Claude API charges apply).
# 0 = enable manually with the desktop "視覚の先読み" button; 1 = enable on launch.
NOTETUTOR_VISION_ENABLED=0
